{
  "name": "@ankhorage/osx",
  "version": "0.1.0",
  "description": "Local macOS diagnostics and maintenance provider for Ankh.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/osx.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.13.7",
    "@ankhorage/devtools": "^2.8.3",
    "@ankhorage/doctor": "^0.14.36",
    "@ankhorage/paradox": "^0.5.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "build": "bun x tsc -p tsconfig.build.json",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "check-types": "bun run typecheck",
    "test": "bun test --pass-with-no-tests",
    "docs": "paradox && ankhorage-prettier --write README.md paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "packageManager": "bun@1.4.2",
  "homepage": "https://github.com/ankhorage/osx#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/osx/issues"
  },
  "keywords": [
    "ankhorage",
    "macos",
    "cli",
    "typescript",
    "bun"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@ankhorage/contracts": "^26.11.1"
  },
  "ankh": {
    "category": "osx",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "osx.backup.status",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect Time Machine status"
      },
      {
        "id": "osx.backup.snapshots.list",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "List APFS snapshots"
      },
      {
        "id": "osx.storage.clean",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Clean storage"
      },
      {
        "id": "osx.storage.scan",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect storage"
      },
      {
        "id": "osx.storage.orphans.scan",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect orphaned application remnants"
      },
      {
        "id": "osx.security.audit",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Audit macOS security posture"
      },
      {
        "id": "osx.security.controls.list",
        "owner": "@ankhorage/osx",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "List macOS security controls"
      }
    ]
  }
}
